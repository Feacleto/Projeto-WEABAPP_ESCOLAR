# Configuração do Firebase — copie este arquivo para `.env` e preencha.
# Em produção, todas as chaves abaixo precisam estar definidas.
# Variáveis com prefixo VITE_ ficam disponíveis no client (são públicas
# por design — a segurança real fica nas Firestore Security Rules).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Push (FCM) — opcional. Gere em Console > Project settings > Cloud Messaging
# > Web Push certificates. Sem esta chave o app funciona normalmente, só não
# oferece notificação com o app fechado.
VITE_FIREBASE_VAPID_KEY=

# Aponta o app pros emuladores locais em `npm run dev`.
# Sem isto, rodar local grava no Firebase de PRODUCAO.
# Suba os emuladores antes: firebase emulators:start
# Tiles do mapa (MapTiler). SEM ela o app cai no servidor do OpenStreetMap,
# que é o caminho de DESENVOLVIMENTO — a política de uso deles não permite
# rastreamento ao vivo. Restrinja a chave ao domínio no painel do MapTiler:
# ela aparece no bundle por desenho, em qualquer provedor de tile.
# Ver src/config/mapa.js.
VITE_MAPTILER_KEY=

# reCAPTCHA Enterprise — a CHAVE DO SITE, no cadastro de motorista.
#
# Ela é PÚBLICA, como as de cima: vai no HTML, aparece no código-fonte da
# página, e é assim em qualquer provedor. Quem protege é a lista de domínios
# no painel do Google — chave restrita e visível é segura; chave secreta em
# app de navegador não existe.
#
# ⚠️ NÃO CONFUNDIR COM A CHAVE DE API (a do `?key=` que valida o token no
# servidor). ESSA é segredo de verdade, NÃO entra aqui, e vazaria para todo
# navegador se entrasse. Ela vive fora do repositório:
#   firebase functions:secrets:set RECAPTCHA_API_KEY
#
# Sem esta variável o cadastro funciona sem o desafio — mesma degradação do
# mapa e do push: o app não quebra, só perde a proteção.
VITE_RECAPTCHA_SITE_KEY=

VITE_USE_EMULATORS=false
