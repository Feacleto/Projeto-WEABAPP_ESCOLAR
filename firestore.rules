rules_version = '2';

// =============================================================================
// Tio Nino Digital — Firestore Security Rules
// =============================================================================
//
// Coleções:
//   users/{uid}        — perfil estendido (role: "admin" | "parent")
//   children/{id}      — crianças cadastradas pelo admin
//   liveLocation/      — doc 'current' com a posição da perua
//   payments/{id}      — mensalidades
//   appState/init      — flag pública "primeiro admin já existe"
//
// Princípios:
//   - Admin tem acesso amplo; pai tem acesso ao próprio filho e seus pagamentos.
//   - Bootstrap do primeiro admin é gated por appState/init (uma vez só).
//   - Signup do pai (signupWithInvite) precisa ler children pra resgatar o
//     invite code; permitido enquanto inviteStatus == 'pending'.
//
// Para deploy: firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }

    // -----------------------------------------------------------------
    // appState/init — flag de bootstrap.
    //   - Leitura pública (Login precisa checar antes do auth)
    //   - Criação livre apenas se o doc ainda não existir; depois só admin atualiza
    // -----------------------------------------------------------------
    match /appState/{docId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/appState/init);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // users/{uid}
    //   - O dono lê e atualiza seu doc
    //   - Admin lê todos
    //   - Criação só pelo dono, e role só pode ser:
    //       * "parent" (signupWithInvite)
    //       * "admin" durante o bootstrap (appState/init ainda não existe)
    //   - Update não pode mudar a role (evita auto-promoção a admin)
    // -----------------------------------------------------------------
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (
          request.resource.data.role == 'parent'
          || (
            request.resource.data.role == 'admin'
            && !exists(/databases/$(database)/documents/appState/init)
          )
        );

      allow update: if isSignedIn() && (
        isAdmin()
        || (
          request.auth.uid == uid
          && request.resource.data.role == resource.data.role
        )
      );

      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // children/{childId}
    //   - Admin: leitura/escrita total
    //   - Pai do filho: leitura
    //   - Qualquer signed-in pode LER children com inviteStatus == 'pending'
    //     (necessário pro fluxo signupWithInvite resgatar o código)
    //   - Update por pai NOVO (signup): só pode mudar parentUid + inviteStatus,
    //     e só se o convite ainda está pendente
    // -----------------------------------------------------------------
    match /children/{childId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.parentUid == request.auth.uid
        || resource.data.inviteStatus == 'pending'
      );

      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.inviteStatus == 'pending'
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.inviteStatus == 'used'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['parentUid', 'inviteStatus'])
      );
    }

    // -----------------------------------------------------------------
    // liveLocation/{docId}
    //   - Todo signed-in lê (admin acompanha telemetria, pai vê perua)
    //   - Só admin escreve (locationService.startTracking/stopTracking)
    // -----------------------------------------------------------------
    match /liveLocation/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------
    // payments/{paymentId}
    //   - Admin: leitura/escrita total
    //   - Pai: leitura SOMENTE dos seus (parentUid == uid)
    // -----------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.parentUid == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // Default deny — qualquer outra coleção é proibida.
    // -----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
