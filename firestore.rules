rules_version = '2';

// =============================================================================
// Tio Nino Digital — Firestore Security Rules
// =============================================================================
//
// Coleções:
//   users/{uid}        — perfil estendido (role: "admin" | "parent")
//   children/{id}      — crianças cadastradas pelo admin
//   liveLocation/      — doc 'current' com a posição da perua
//   payments/{id}      — mensalidades
//   appState/init      — flag pública "primeiro admin já existe"
//
// Princípios:
//   - Admin tem acesso amplo; pai tem acesso ao próprio filho e seus pagamentos.
//   - Bootstrap do primeiro admin é gated por appState/init (uma vez só).
//   - Signup do pai (signupWithInvite) precisa ler children pra resgatar o
//     invite code; permitido enquanto inviteStatus == 'pending'.
//
// Para deploy: firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // MOTORISTA ATIVO. O nome `admin` é histórico e confunde: no código inteiro
    // ele quer dizer "quem opera uma perua", não "quem administra a
    // plataforma". É este papel que libera crianças, pagamentos, rotas e
    // agenda.
    //
    // SUSPENSO NÃO É MOTORISTA, E A TRAVA MORA AQUI
    // Suspensão que só existisse na interface seria enfeite: o parceiro
    // suspenso continuaria com token válido e continuaria escrevendo na
    // operação por qualquer outro caminho — outro aparelho, uma aba antiga,
    // um script. Negando dentro do `isAdmin()`, a suspensão vale pra TODAS as
    // coleções que dependem dele de uma vez, e não uma por uma.
    //
    // `.get('suspenso', false)` e não `.suspenso`: acessar chave ausente é
    // erro de avaliação, e erro de avaliação nega. Sem o default, publicar
    // esta linha trancaria fora TODO motorista cujo doc não tem o campo — ou
    // seja, todos eles.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin'
        && userDoc().get('suspenso', false) != true;
    }

    // "ESTE DOCUMENTO É DESTE MOTORISTA?" — o escopo por parceiro.
    //
    // Vale pra `children` e `payments`, as duas coleções que carregam a
    // operação e o dinheiro de um parceiro. O `.get('adminUid', '')` existe
    // porque chave ausente é erro de avaliação (que nega, mas nega com ruído
    // difícil de ler no console); com default, documento legado simplesmente
    // não pertence a ninguém — e é por isso que o backfill vem antes.
    //
    // ATENÇÃO PRA CONSULTA: rule que exige campo obriga a CONSULTA a provar
    // o filtro. `where('adminUid','==',uid)` não é otimização, é requisito —
    // sem ele o Firestore recusa a consulta inteira, e a tela vem vazia em
    // vez de vir parcial.
    function ehDoMotorista() {
      return isAdmin()
        && resource.data.get('adminUid', '') == request.auth.uid;
    }

    // DONO DA PLATAFORMA — quem faz a gestão do produto: aprova motorista,
    // abre e fecha depoimento, olha os números do negócio.
    //
    // POR QUE ELE PRECISOU DE UM PAPEL PRÓPRIO
    // Antes o dono era um MOTORISTA com `superAdmin: true` por cima, porque
    // as leituras do painel exigiam `isAdmin()`. Isso tinha dois efeitos
    // ruins e um deles é conceitual:
    //
    //   - ele entrava no /tio e mexia na operação de um parceiro — abria a
    //     rota, editava criança, dava baixa em pagamento. Nada disso é dele;
    //   - e era contado como parceiro nas métricas da própria plataforma.
    //
    // Agora `role: 'owner'` é papel de primeira classe, e `isOwner()` libera
    // só o que a GESTÃO precisa: ler as coleções que o painel resume e mexer
    // na fila de parceiros e na visibilidade de depoimento. Ele NÃO ganha
    // escrita na operação: criança, pagamento, rota e agenda continuam
    // exigindo `isAdmin()`.
    //
    // O DONO É UMA CONTA SÓ, E `superAdmin` SAIU DAQUI.
    // O fallback existia como ponte pra conta antiga. Ele criava duas
    // assimetrias, e as duas doem só num incidente:
    //
    //   - o cliente (`ehDono()` em src/utils/papeis.js) já não aceita o
    //     booleano. Cliente e servidor discordando sobre quem é dono é a
    //     pior classe de bug: a tela mostra uma coisa e o banco decide outra;
    //   - "quantos donos existem?" deixava de ser uma query e passava a ser
    //     uma auditoria de campo esquecido em doc antigo.
    //
    // A migração é MANUAL e vem antes: o doc do dono passa a `role: 'owner'`
    // pelo console, porque o cliente não escreve `role` de propósito.
    // `superAdmin` CONTINUA VALENDO, e não é dívida — é a única prova que a
    // conta atual do dono tem.
    //
    // O papel `owner` é o destino certo, e conta nova nasce com ele. Mas a
    // conta do dono hoje é `role: 'admin'` + `superAdmin: true`, e migrar
    // exige console: a regra de update proíbe escrever `role` pelo cliente
    // (foi assim que a auto-promoção do motorista foi fechada, e vale pra
    // todo mundo). Exigir só `owner` trancaria o dono fora do próprio painel,
    // sem caminho no app pra sair.
    //
    // E aceitar o campo é SEGURO, não é concessão: `superAdmin` está na lista
    // de chaves que nenhum cliente escreve — sondado contra produção, HTTP
    // 403. Se um documento tem esse campo, quem o pôs foi o console ou o
    // Admin SDK. A objeção legítima ao fallback é de legibilidade ("quantos
    // donos existem?" vira duas perguntas em vez de uma), não de segurança.
    function isOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userDoc().role == 'owner' || userDoc().superAdmin == true);
    }

    // DONO DO DOCUMENTO OPERACIONAL. O campo `adminUid` no corpo é o que dá
    // escopo às coleções que antes eram `isAdmin()` puro — e `isAdmin()`,
    // neste projeto, quer dizer QUALQUER MOTORISTA.
    //
    // `.get('adminUid', '')` em vez de acesso direto: documento legado sem o
    // campo faz o acesso nu virar erro de avaliação, e erro nega. Com o
    // default, o legado simplesmente não casa com ninguém — nega igual, mas
    // por decisão em vez de por acidente.
    function doDono() {
      return isAdmin() && resource.data.get('adminUid', '') == request.auth.uid;
    }
    function nasceDoDono() {
      return isAdmin()
        && request.resource.data.get('adminUid', '') == request.auth.uid;
    }

    // Tem conta de VERDADE no app (doc em users/). A landing chama
    // signInAnonymously pra gravar leads, então `isSignedIn()` sozinho
    // inclui qualquer visitante do site — e não deveria dar acesso a
    // nada que fale de crianças, escolas ou avisos.
    // AGUARDANDO NÃO É USUÁRIO DO APP, e a exclusão aqui é o que impede a
    // fila de espera de virar porta.
    //
    // Quem se inscreve como associado sai com conta criada (`role:
    // 'aguardando'`) e entra no app pra ver a própria posição na fila. Isso
    // dá a ele um documento em `users` — e `isAppUser()` significa
    // literalmente "tem documento em users".
    //
    // Sem esta linha, um inscrito não aprovado passaria a ler
    // `schoolBroadcasts` e `agendaEntries` do parceiro que JÁ está dentro:
    // nome de escola, recado do motorista pras famílias, aviso de dia sem
    // aula. Alguém que preencheu um formulário lendo a operação de quem
    // paga pra estar aqui.
    //
    // É exatamente o mesmo erro da sessão anônima, com outra roupa: um estado
    // intermediário que ninguém classificou como "usuário" acabando dentro da
    // definição por acidente.
    function isAppUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role != 'aguardando';
    }

    // -----------------------------------------------------------------
    // platformConfig/{docId} — os interruptores do DONO.
    //
    // Leitura livre: o app precisa saber se o período de avaliação está
    // aberto antes de decidir o que desenhar, e isso vale inclusive pra
    // quem ainda não tem conta. Não há nada sensível aqui.
    //
    // Escrita SÓ de isOwner(), e é por isso que este bloco existe em vez de
    // reusar appState/init: a regra daquele é `isAdmin()`, que neste projeto
    // significa MOTORISTA. Guardar um interruptor de plataforma lá deixaria
    // qualquer parceiro abrir e fechar o período de avaliação de todo mundo.
    // -----------------------------------------------------------------
    match /platformConfig/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // -----------------------------------------------------------------
    // appState/init — flag de bootstrap.
    //   - Leitura pública (Login precisa checar antes do auth)
    //   - Criação livre apenas se o doc ainda não existir; depois só admin atualiza
    // -----------------------------------------------------------------
    // ESTE DOC É UM PONTEIRO GLOBAL, E POR ISSO NÃO É DO MOTORISTA.
    //
    // `appState/init.adminUid` responde "quem é o motorista" pra nove pontos
    // do sistema, incluindo a CHAVE PIX mostrada ao responsável e a do e-mail
    // de cobrança. Com `allow update: if isAdmin()` — que aqui significa
    // qualquer motorista — um parceiro apontava o ponteiro pra si mesmo e os
    // pais de TODOS os outros passavam a pagar na conta dele.
    //
    // Sondado contra produção com dois motoristas reais: o segundo reescreveu
    // `adminUid` e recebeu HTTP 200. Revertido no mesmo teste.
    //
    // O `delete` era o primeiro elo de uma escalada completa: apagar este doc
    // reabre o ramo de bootstrap de `users` (que só exige `appState/init`
    // ausente), e por ele um motorista se recriava com `superAdmin: true`.
    // Três escritas, e ele virava dono da plataforma.
    //
    // Escrita passa a ser de isOwner(). Encerrar operação não precisa apagar
    // este doc — e não deve: apagá-lo reabre /first-admin pro próximo
    // visitante que souber a URL.
    match /appState/{docId} {
      allow read: if true;
      // Bootstrap exige sessão: sem isso, um anônimo cria o doc com o
      // adminUid que quiser antes do dono legítimo chegar.
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/appState/init);
      allow update, delete: if isOwner();
    }

    // -----------------------------------------------------------------
    // users/{uid}
    //   - O dono lê e atualiza seu doc
    //   - Admin lê todos
    //   - Criação só pelo dono, e role só pode ser:
    //       * "parent" (signupWithInvite)
    //       * "admin" durante o bootstrap (appState/init ainda não existe)
    //   - Update não pode mudar a role (evita auto-promoção a admin)
    // -----------------------------------------------------------------
    match /users/{uid} {
      // Próprio dono lê o seu doc; admin lê todos.
      //
      // O doc DO admin é legível pelos usuários do app porque o pai
      // precisa ver a chave PIX e o telefone do motorista. Mas isso exige
      // isAppUser(), não isSignedIn(): a landing chama signInAnonymously
      // pra gravar leads, e com isSignedIn() qualquer visitante do site
      // lia nome, email, telefone e CHAVE PIX do motorista.
      allow get: if isSignedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (isAppUser() && resource.data.role == 'admin')
      );
      // SÓ O DONO LISTA. O motorista não tem por que varrer `users`.
      //
      // `users` não tem como ser escopado numa consulta (não havia `adminUid`
      // até agora), então `allow list: if isAdmin()` era um dump da base
      // inteira: nome, e-mail, telefone e CHAVE PIX de todo responsável e de
      // todo parceiro concorrente, num `getDocs` de uma linha. Sondado: HTTP
      // 200, base inteira devolvida.
      //
      // Conferido antes de apertar: os três lugares que listam `users`
      // (TaxaTab, adminMetricsService, associadoService) são todos do dono.
      // Nenhuma tela do motorista lista usuários — isto não tira função de
      // ninguém.
      allow list: if isOwner();

      // CREATE só existe pro bootstrap do primeiro motorista.
      //
      // A cláusula que aceitava role == 'parent' de qualquer signed-in foi
      // REMOVIDA, e ela era uma escalada de privilégio de verdade:
      //
      //   1. A landing chama signInAnonymously pra gravar leads, então
      //      qualquer visitante do site tem um uid.
      //   2. O create não restringia CAMPOS. Dava pra criar o próprio doc
      //      com role 'parent' E childIds: ['qualquer-id'].
      //   3. Com isso o visitante virava isAppUser() e passava as regras de
      //      liveLocation — ou seja, lia a POSIÇÃO AO VIVO da perua — além do
      //      doc do motorista, com telefone e chave PIX.
      //
      // Nada do cliente precisa disso: desde que o resgate de convite virou
      // Cloud Function, quem cria users/{uid} de responsável é o redeemInvite
      // com Admin SDK, que não passa por rules. Só o bootstrap do admin
      // (createFirstAdmin) ainda escreve daqui.
      // Dois caminhos, e só dois:
      //
      //   1. BOOTSTRAP — o primeiro motorista se cria sozinho, e a porta
      //      fecha atrás dele (`appState/init`).
      //   2. PROVISIONAMENTO PELO DONO — o parceiro aprovado na fila. Antes
      //      disto, "aprovar" no painel era só um recado pra si mesmo: a
      //      conta tinha que ser criada à mão no console, e a decisão ficava
      //      num limbo entre o funil e o banco.
      //
      // O QUE O DONO NÃO CONSEGUE FAZER AQUI, mesmo tendo o create liberado:
      //   - criar outro DONO. `role` tem que ser 'admin', e o `hasOnly`
      //     abaixo nem admite a chave `superAdmin`. O dono é uma conta só, e
      //     essa contagem não pode depender de bom comportamento do cliente;
      //   - vincular criança. `childId`/`childIds` estão fora da whitelist:
      //     quem cria vínculo é o resgate de convite, não a gestão;
      //   - forjar aceite de termos. `termsVersion` e companhia estão fora:
      //     o motorista novo cai no gate e aceita ele mesmo, com o próprio
      //     login. Consentimento que a plataforma escreve pelo usuário não é
      //     consentimento.
      //
      // A criação do login no Firebase Auth acontece no cliente, numa
      // instância secundária (src/services/provisionamentoService.js) — o
      // Auth já permite a qualquer pessoa criar conta com e-mail e senha,
      // então o privilégio de verdade é ESTE doc, e é aqui que ele é gateado.
      // O RAMO DE BOOTSTRAP TAMBÉM TEM WHITELIST — ele era o único sem.
      //
      // Os outros dois ramos listam os campos permitidos, e `superAdmin` fica
      // de fora deles. Este não listava nada, e virava o terceiro passo de uma
      // escalada: apagar `appState/init` (que era `isAdmin()`), apagar o
      // próprio doc (que o dono do doc pode), e recriar-se aqui com
      // `superAdmin: true` — que `isOwner()` aceita. Três escritas, nenhuma
      // delas exigindo mais que uma conta comum de motorista.
      //
      // A sonda antiga (`scripts/auditar-regras.cjs`) testava `superAdmin` só
      // no `update`, e passava verde. É o mesmo aprendizado de antes, na
      // forma que mais custa: sempre que o `update` for restritivo, pergunte
      // "e se ele criar o documento do zero?".
      allow create: if (
        isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/appState/init)
        && request.resource.data.keys().hasOnly([
          'role', 'name', 'email', 'phone', 'city', 'createdAt'
        ])
      ) || (
        isOwner()
        && request.resource.data.role == 'admin'
        && request.resource.data.keys().hasAll(['role', 'name', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'role', 'name', 'email', 'phone', 'city',
          'createdAt', 'provisionedBy', 'provisionedFromLead'
        ])
        && request.resource.data.provisionedBy == request.auth.uid
      ) || (
        // INSCRIÇÃO NA LISTA DE ASSOCIADOS — a conta nasce AGUARDANDO.
        //
        // A inscrição É o cadastro do motorista: ele preenche, entra, e vê a
        // própria posição na fila enquanto a aprovação é negociada fora do
        // sistema. Por isso o create é aberto pra qualquer um que acabou de
        // se autenticar — e por isso `aguardando` não pode valer nada.
        //
        // O QUE TORNA ISTO SEGURO não é a whitelist abaixo, é o papel:
        // `aguardando` não passa em `isAdmin()`, não passa em `isOwner()` e
        // foi EXCLUÍDO de `isAppUser()`. Quem cria uma conta dessas alcança
        // exatamente nada além do próprio documento. Se amanhã alguém
        // esquecer uma checagem numa regra nova, o esquecimento não abre
        // porta — o papel já não abria.
        //
        // A whitelist existe pra ele não nascer com campo que não é dele:
        // sem `superAdmin`, sem `childIds`, sem `adminUid`. E `role` fixo em
        // 'aguardando' impede a auto-promoção no ato da criação, que seria o
        // caminho óbvio — criar já como 'admin'.
        isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'aguardando'
        && request.resource.data.keys().hasAll(['role', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'role', 'name', 'email', 'phone', 'city', 'fleet',
          'createdAt', 'posicaoNaFila'
        ])
      );

      // O dono atualiza o próprio doc, mas NÃO pode mexer em role nem no
      // vínculo de crianças. Quem escreve childIds/childId é a Cloud
      // Function redeemInvite (Admin SDK) — deixar o cliente escrever
      // esses campos permitiria auto-atribuição de filhos.
      // OS QUATRO CAMPOS DE PRIVILÉGIO NÃO SE ESCREVEM DAQUI. POR NINGUÉM.
      //
      // A versão anterior tinha `isAdmin()` como primeiro termo de um OU, e
      // isso curto-circuitava tudo o que vinha depois: quem já tinha
      // role == 'admin' — ou seja, QUALQUER MOTORISTA — passava direto e
      // podia gravar o que quisesse em qualquer users/{uid}, inclusive no
      // próprio. Na prática:
      //
      //   - o motorista se dava `superAdmin: true` e abria o /admin, que
      //     mostra o negócio da PLATAFORMA: GMV, tamanho da base, fila de
      //     parceiros, avaliações de todo mundo;
      //   - e podia trocar o próprio `role`, ou o de outro usuário.
      //
      // Não era teoria: a sondagem de rules (scripts/auditar-regras.cjs)
      // executou os dois contra o ambiente publicado e os DOIS passaram.
      //
      // A restrição agora vem ANTES do OU, então vale para os dois ramos. O
      // que sobra é o legítimo: o motorista edita dados de cadastro (nome,
      // telefone, PIX, foto) do próprio doc e dos que ele administra; o
      // usuário edita o próprio. Vínculo de criança e papel continuam sendo
      // escritos só pelo `redeemInvite` com Admin SDK, que não passa por
      // rules — e por isso não perde nada aqui.
      // A ORDEM DOS RAMOS MUDOU, E O MOTIVO FOI UM FURO ENCONTRADO NO TESTE.
      //
      // Antes o `hasAny` de campos proibidos vinha ANTES do OU e valia pros
      // dois ramos — o que estava certo pra `role` e `superAdmin`. Quando os
      // campos de GESTÃO entraram (`suspenso`), a lista não os acompanhou, e
      // o ramo "a própria pessoa edita o próprio doc" passou a incluí-los:
      // o motorista SUSPENSO gravava `suspenso: false` em si mesmo e voltava
      // a operar. A sonda do emulador pegou isso, e a rule compilava e lia
      // bem — é o tipo de furo que revisão de olho não acha.
      //
      // Agora o ramo do DONO vem primeiro e é fechado em si (só os campos de
      // gestão), e o ramo de todo mundo proíbe privilégio E gestão juntos.
      allow update: if (
        // APROVAR UM INSCRITO — a única transição de `role` que existe.
        //
        // Trocar `role` é a escrita mais protegida do sistema: foi por ela
        // que um motorista se promovia a dono. Esta exceção é estreita de
        // propósito, e cada termo fecha um caminho:
        //
        //   isOwner()                     só o dono aprova
        //   resource.role == 'aguardando' só sai da fila; conta ativa não
        //                                 pode ser rebaixada nem mexida
        //   request.role == 'admin'       só chega em MOTORISTA. Não existe
        //                                 caminho pra virar 'owner' — o dono
        //                                 não se multiplica por aqui
        //   hasOnly([...])                e nada mais viaja junto: nem
        //                                 superAdmin, nem childIds, nem
        //                                 adminUid
        //
        // Aprovação é irreversível por aqui de propósito. Desfazer um aceite
        // é suspender (`suspenso`), que é o ramo abaixo e deixa rastro — não
        // é apagar o fato de que a conta foi aprovada um dia.
        isOwner()
        && resource.data.role == 'aguardando'
        && request.resource.data.role == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['role', 'aprovadoEm', 'aprovadoPor'])
      ) || (
        // O DONO GERENCIA, NÃO EDITA CADASTRO ALHEIO.
        // Três campos, e nenhum é dado do parceiro: suspender, quando
        // suspendeu, e a nota interna da plataforma. Nome, telefone e chave
        // PIX continuam sendo do motorista — a plataforma não reescreve o
        // cadastro de quem ela hospeda, nem por conveniência de suporte.
        isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['suspenso', 'suspensoEm', 'notaInterna'])
      ) || (
        isSignedIn()
        // PRIVILÉGIO E GESTÃO: NINGUÉM ESCREVE DAQUI, NEM EM SI MESMO.
        //
        // `role`/`superAdmin` porque era assim que um motorista se promovia
        // a dono da plataforma (sondado contra o ambiente publicado, e
        // passava). `childId`/`childIds` porque vínculo de criança é do
        // `redeemInvite` com Admin SDK, e auto-atribuição de filho daria
        // acesso à posição ao vivo da perua. `suspenso` e companhia porque
        // suspensão que o suspenso desfaz não é suspensão.
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny([
               'role', 'childId', 'childIds', 'superAdmin',
               'suspenso', 'suspensoEm', 'notaInterna'
             ])
        && (
          // Quem edita: o motorista, NOS DOCS QUE SÃO DELE, ou a própria
          // pessoa. A checagem redundante de `role` fica como segunda tranca
          // — se alguém mexer na lista de campos acima, esta aqui ainda barra
          // a troca de papel do próprio doc.
          //
          // O `isAdmin()` estava SOZINHO aqui, sem amarrar `{uid}` a nada — e
          // o comentário lá em cima já prometia "e dos que ele administra",
          // escopo que a regra não tinha. Todo campo fora da lista proibida
          // (pixKey, phone, email, name...) era gravável por qualquer
          // motorista em QUALQUER doc de users.
          //
          // Sondado com dois motoristas reais em produção: o segundo
          // reescreveu a `pixKey` do primeiro e recebeu HTTP 200. Os
          // responsáveis do primeiro abririam o financeiro, veriam a chave do
          // segundo e pagariam nela — sem nada mudar na tela de quem foi
          // roubado, até ele abrir /tio/pix. Revertido no mesmo teste.
          //
          // `adminUid` no doc do responsável é o que dá escopo: quem o grava
          // é o resgate de convite (Admin SDK), copiado de `child.adminUid`.
          (isAdmin() && resource.data.get('adminUid', '') == request.auth.uid)
          || (
            request.auth.uid == uid
            && request.resource.data.role == resource.data.role
          )
        )
      );

      // O próprio dono apaga o seu (excluir minha conta); o motorista apaga
      // o doc DOS RESPONSÁVEIS DELE (remover pai vinculado).
      //
      // `isAdmin()` sem escopo aqui deixava um motorista apagar o doc de
      // qualquer conta — inclusive a do dono, que perderia `role` e
      // `superAdmin` sem nenhum caminho no app pra se recriar (o ramo de
      // bootstrap exige `appState/init` ausente). Destruição de conta com
      // DoS no dono junto, a partir de uma conta comum de parceiro.
      // O DONO TAMBÉM REMOVE. Escopar o motorista sem reabrir pro dono deixava
      // a plataforma sem como desligar um parceiro que saiu — descoberto na
      // hora de limpar uma conta de teste, que é onde esse tipo de aperto
      // demais costuma aparecer.
      allow delete: if isSignedIn() && (
        request.auth.uid == uid
        || isOwner()
        || (isAdmin() && resource.data.get('adminUid', '') == request.auth.uid)
      );
    }

    // -----------------------------------------------------------------
    // children/{childId}
    //   - Admin: leitura/escrita total
    //   - Pai do filho: leitura
    //   - Resgate de convite NÃO passa mais por aqui: quem resolve o código
    //     é a Cloud Function redeemInvite (Admin SDK, em transação)
    // -----------------------------------------------------------------
    match /children/{childId} {
      // A cláusula `inviteStatus == 'pending'` foi REMOVIDA daqui.
      // Ela existia pra o cliente achar a criança pelo invite code, mas
      // como a landing faz signInAnonymously, qualquer visitante do site
      // conseguia listar todas as crianças pendentes com nome, endereço,
      // coordenada, escola e telefone do responsável.
      // Agora quem resolve convite é a Cloud Function `lookupInvite` /
      // `redeemInvite`, que roda com Admin SDK e devolve o mínimo.
      // O dono LÊ pra contar a base, mas NÃO escreve: cadastro de criança
      // é operação do parceiro, não gestão da plataforma.
      // CADA MOTORISTA ALCANÇA AS CRIANÇAS DELE, E SÓ.
      //
      // Antes bastava `isAdmin()`: QUALQUER motorista lia e escrevia QUALQUER
      // criança. Com um parceiro só, ninguém via o problema — no segundo,
      // cada um passa a ler nome, endereço, coordenada, escola e telefone das
      // famílias do outro, e a plataforma não teria como dizer que não. É a
      // classe de falha que só aparece no dia em que o produto dá certo.
      //
      // `ehDoMotorista()` compara `adminUid` com o uid da sessão, com default
      // vazio pra chave ausente — acessar chave inexistente é erro de
      // avaliação, e erro nega. Documento legado (sem `adminUid`) portanto
      // NÃO é lido por motorista nenhum: o backfill
      // (scripts/backfill-adminuid.cjs) tem que rodar ANTES de publicar isto,
      // senão o parceiro atual abre o painel e não vê as próprias crianças.
      //
      // O DONO CONTINUA LENDO TUDO, e isso é deliberado: ele conta a base e
      // resume o negócio. Ler não é operar — escrita segue proibida pra ele.
      allow read: if isSignedIn() && (
        ehDoMotorista()
        || isOwner()
        || resource.data.parentUid == request.auth.uid
      );

      // Criar exige carimbar a própria autoria: sem isto, um motorista
      // cadastraria criança JÁ na conta de outro, e o dado nasceria fora do
      // alcance de quem ele pertence.
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid;
      allow delete: if ehDoMotorista();

      // Updates permitidos (não-admin):
      //   a) Aceitar invite: pending → used, parentUid = auth.uid
      //   b) Desvincular (pai apagando própria conta): used → pending,
      //      parentUid = null. Só se parentUid atual é do próprio auth.uid.
      //   c) Aceitar contrato (pai vinculado): grava campos de aceite.
      //      Só permitido se ainda não foi aceito (contractAcceptedAt null).
      // O vínculo pending → used NÃO é mais feito pelo cliente: quem faz é
      // a Cloud Function redeemInvite, em transação (evita dois pais
      // resgatarem o mesmo código). O caminho inverso (desvincular ao
      // apagar a conta) continua aqui — é o próprio dono agindo.
      // O motorista edita as dele, e não pode transferir a criança pra outro
      // (`adminUid` imutável): mudar o dono do documento é o mesmo que
      // escrever na operação alheia, só que em duas etapas.
      allow update: if (
        ehDoMotorista()
        && request.resource.data.adminUid == resource.data.adminUid
      ) || (
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.parentUid == null
        && request.resource.data.inviteStatus == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['parentUid', 'inviteStatus'])
      ) || (
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.contractAcceptedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'contractVersion',
              'contractAcceptedAt',
              'contractAcceptedByUid',
              'contractAcceptedName',
              'contractHash',
              'contractUserAgent',
            ])
      ) || (
        // Pai gerencia lista de responsáveis alternativos do próprio filho
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['altResponsibles'])
      ) || (
        // Pai atualiza foto da própria criança (reflete pro Tio).
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['photoURL'])
      ) || (
        // Pai informa turma e sala. É o único que sabe — o motorista não
        // acompanha a criança até a porta da sala, e perguntar a ele seria
        // perguntar pra quem não tem a resposta.
        //
        // São dois campos de texto sem efeito em rota, cobrança ou permissão:
        // o pior caso de um pai mal-intencionado aqui é escrever bobagem na
        // ficha do próprio filho.
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['turma', 'sala'])
      );
    }

    // -----------------------------------------------------------------
    // children/{id}/rides/{YYYY-MM-DD} — a viagem de cada dia
    //
    // Guarda a hora de cada marco (embarcou, chegou na escola, foi entregue) e
    // a posição da criança na fila do dia. Existe porque `children.status`
    // guardava só o ÚLTIMO passo: o tracker do responsável não conseguia dizer
    // "chegou na escola às 7h12", e no dia seguinte não havia como reconstruir
    // a rota numa reclamação.
    //
    // A permissão sai do doc PAI. A subcoleção não herda regra no Firestore —
    // sem este bloco ela cairia no `match /{document=**}` e ficaria fechada, o
    // que é seguro mas deixa o tracker sem hora. Aqui o `get()` no doc da
    // criança dá a resposta exata: o motorista dela escreve, o responsável dela
    // lê, e mais ninguém.
    // -----------------------------------------------------------------
    match /children/{childId}/rides/{dia} {
      function crianca() {
        return get(/databases/$(database)/documents/children/$(childId)).data;
      }
      allow read: if isSignedIn() && (
        (isAdmin() && crianca().get('adminUid', '') == request.auth.uid)
        || crianca().get('parentUid', '') == request.auth.uid
      );
      // O responsável NÃO escreve: a hora da entrega é registro de quem
      // entregou. Deixar o outro lado escrever tiraria dela o valor de prova.
      allow write: if isAdmin()
        && crianca().get('adminUid', '') == request.auth.uid;
    }

    // -----------------------------------------------------------------
    // liveLocation/{docId}
    //   - Todo signed-in lê (admin acompanha telemetria, pai vê perua)
    //   - Só admin escreve (locationService.startTracking/stopTracking)
    // -----------------------------------------------------------------
    match /liveLocation/{docId} {
      // Leitura: admin, ou pai VINCULADO (users/{uid}.childId preenchido).
      // Exigir o doc users/ exclui sessões anônimas — a landing chama
      // signInAnonymously pra gravar leads de waitlist, e sem essa checagem
      // qualquer visitante do site rastreava a perua em tempo real.
      // UM DOCUMENTO POR MOTORISTA: o {docId} É o uid dele.
      //
      // Era `liveLocation/current`, caminho fixo pra plataforma inteira, com
      // `driverUid` no corpo que ninguém lia. Sondado em produção com dois
      // motoristas: os dois escreveram HTTP 200 e o doc terminou do segundo.
      //
      // A escrita compara {docId} com o uid direto — sem campo no corpo,
      // porque aqui o próprio caminho já é a identidade, como em users/{uid}.
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          // O motorista lê a própria posição.
          (isAdmin() && docId == request.auth.uid)
          // O responsável lê a do motorista DELE, e só. Antes qualquer pai
          // vinculado lia o doc único — o que, com dois motoristas, é a
          // perua de um estranho no mapa da família, e o aviso "está
          // chegando" disparado pela van errada.
          || (
            userDoc().get('adminUid', '') == docId
            && (
              userDoc().childId != null
              // childIds é o modelo novo (um responsável, vários filhos).
              // Sem esta linha, um pai migrado pro array perderia o mapa.
              || (userDoc().childIds is list && userDoc().childIds.size() > 0)
            )
          )
        );
      // O dono limpa posições órfãs (ex.: o `liveLocation/current` legado, que
      // ficou sem leitor quando o doc passou a ser por motorista) — sem isso
      // ninguém consegue apagar um documento cujo id não é uid de ninguém.
      allow write: if (isAdmin() && docId == request.auth.uid) || isOwner();
    }

    // -----------------------------------------------------------------
    // payments/{paymentId}
    //   - Admin: leitura/escrita total
    //   - Pai: leitura SOMENTE dos seus (parentUid == uid)
    //   - Pai: pode atualizar APENAS pra alternar entre 'pending' <-> 'claimed'
    //     (marcar/desmarcar "paguei"). Nunca pode escrever 'paid' direto.
    // -----------------------------------------------------------------
    match /payments/{paymentId} {
      // O dono LÊ pro GMV do painel, e só. Dar baixa em pagamento é
      // operação do parceiro — a plataforma não mexe no dinheiro dele.
      //
      // E CADA MOTORISTA SÓ ALCANÇA O PRÓPRIO FINANCEIRO. Antes, `isAdmin()`
      // sozinho dava create, update e DELETE de qualquer pagamento a qualquer
      // motorista: um parceiro podia apagar a cobrança do outro, ou dar baixa
      // no dinheiro que não é dele. O responsável continua entrando pelo
      // `parentUid`, que é o vínculo dele com a cobrança.
      allow read: if isSignedIn() && (
        ehDoMotorista()
        || isOwner()
        || resource.data.parentUid == request.auth.uid
      );
      // ATENÇÃO, QUEM FOR MEXER NA COBRANÇA: quando a geração de mensalidade
      // voltar a rodar (Cloud Function `generateMonthlyPayments`), ela precisa
      // gravar `adminUid` no pagamento — o Admin SDK não passa por rules, mas
      // um pagamento sem `adminUid` fica invisível pro motorista dono dele,
      // porque a consulta da tela filtra por esse campo.
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid;
      allow delete: if ehDoMotorista();
      allow update: if (
        ehDoMotorista()
        && request.resource.data.adminUid == resource.data.adminUid
      ) || (
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && (
          (resource.data.status == 'pending' && request.resource.data.status == 'claimed')
          || (resource.data.status == 'claimed' && request.resource.data.status == 'pending')
        )
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status',
              'claimedAt',
              'paymentMethod',
              'receiptURL',
              // Hash do arquivo, pro servidor detectar comprovante reusado.
              'receiptHash',
            ])
        // O comprovante tem que ser arquivo do NOSSO Storage. Sem esta
        // checagem o pai gravava qualquer URL no campo, e o tio clicaria
        // nela achando que era o comprovante.
        && (
          !("receiptURL" in request.resource.data)
          || request.resource.data.receiptURL == null
          || request.resource.data.receiptURL.matches(
               'https://firebasestorage[.]googleapis[.]com/.*'
             )
        )
      );
    }

    // -----------------------------------------------------------------
    // payments/{id}/events/{eventId} — trilha APPEND-ONLY do pagamento
    //
    // Só CREATE. Nem update nem delete, pra ninguém — nem pro admin.
    // Essa é justamente a propriedade que faz a trilha valer como prova:
    // antes, `undoReceipt` zerava o claimedAt e o registro de que o pai
    // declarou o pagamento desaparecia. Sem histórico, discordância
    // honesta não tem como ser resolvida, e quem cede é quem tem menos
    // poder na relação.
    //
    // Leitura: admin e o próprio responsável daquele pagamento — os dois
    // lados precisam poder consultar a mesma trilha.
    // -----------------------------------------------------------------
    match /payments/{paymentId}/events/{eventId} {
      function paymentDoc() {
        return get(/databases/$(database)/documents/payments/$(paymentId)).data;
      }

      allow read: if isSignedIn() && (
        isAdmin() || paymentDoc().parentUid == request.auth.uid
      );

      allow create: if isSignedIn()
        && (isAdmin() || paymentDoc().parentUid == request.auth.uid)
        && request.resource.data.keys().hasAll(['type', 'at'])
        && request.resource.data.actorUid == request.auth.uid;

      // Definitivo por design. Nem update nem delete, PRA NINGUÉM — nem
      // pro dono da plataforma.
      //
      // Aqui morava, por engano, o `allow update` do `hiddenByOwner` dos
      // depoimentos: eu escrevi a regra e ela caiu no bloco errado, 230
      // linhas acima do `match /feedbacks/{id}` a que pertencia. O efeito
      // era duplo e os dois lados silenciosos — a moderação de depoimento
      // nunca funcionaria, e ESTA trilha deixava de ser append-only sem
      // que o comentário acima parasse de prometer o contrário.
      //
      // É a sétima vez neste projeto que um comentário promete garantia
      // que o código ao lado não dá. As seis primeiras eu encontrei; esta
      // eu causei, e outra sessão pegou lendo o enquadramento dos blocos.
      // Comentário é hipótese, inclusive quando quem escreveu foi você.
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // notifications/{id}
    //   - Cada doc pertence a um único userId (dono).
    //   - Dono lê/atualiza (marcar como lida) seus próprios docs.
    //   - Admin lê tudo (útil pra suporte).
    //   - Criação: signed-in pode criar pra qualquer userId — controle de
    //     conteúdo é validado pelos campos obrigatórios. Cenários válidos:
    //       * Pai cria notif pro tio quando marca pagamento como pago
    //       * Tio cria notif pro pai quando confirma recebimento
    //   - Delete: dono apaga as suas, admin apaga qualquer uma.
    // -----------------------------------------------------------------
    match /notifications/{notifId} {
      // Read combinado (get + list): força a query a ter where userId == auth.uid
      // — sem isso, list seria permissivo demais e usuário poderia consultar
      // notificações alheias.
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );

      // Create: além dos campos obrigatórios, restringe QUEM pode ser alvo.
      //   - Admin (Tio) cria pra qualquer userId.
      //   - Não-admin só cria pra o admin (ex: pai marca "paguei" e avisa o Tio).
      // Sem a segunda cláusula, qualquer signed-in — inclusive sessão anônima
      // da landing — injetava notificação com título/corpo arbitrário na conta
      // de qualquer usuário (phishing in-app).
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasAll(['userId', 'type', 'title', 'createdAt'])
        && request.resource.data.userId is string
        && request.resource.data.type is string
        && (
          isAdmin()
          || request.resource.data.userId ==
              get(/databases/$(database)/documents/appState/init).data.adminUid
        );

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readAt']);

      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
    }

    // -----------------------------------------------------------------
    // altPickups/{dateKey_childId} — indicação diária de quem vai buscar
    //   - Pai pode CRUD do próprio filho.
    //   - Admin lê tudo + também pode escrever (caso queira corrigir).
    // -----------------------------------------------------------------
    match /altPickups/{id} {
      function ownsChild(childId) {
        return isSignedIn()
          && exists(/databases/$(database)/documents/children/$(childId))
          && get(/databases/$(database)/documents/children/$(childId)).data.parentUid == request.auth.uid;
      }
      allow read: if isSignedIn() && (
        isAdmin() || ownsChild(resource.data.childId)
      );
      allow create: if isAdmin() || (
        isSignedIn() && ownsChild(request.resource.data.childId)
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && ownsChild(resource.data.childId)
        && request.resource.data.childId == resource.data.childId
      );
      allow delete: if isAdmin() || (
        isSignedIn() && ownsChild(resource.data.childId)
      );
    }

    // -----------------------------------------------------------------
    // routePlans e dailyRoutes MORRERAM com os turnos.
    //
    // Guardavam a ordem fixa das seis filas e o override do dia. A rota deixou
    // de ser uma lista salva: ela é o resultado de ordenar quem tem horário
    // combinado, então não há mais o que planejar num documento.
    //
    // As regras saem junto com o código. Regra publicada pra coleção morta não
    // é vazamento — estas eram restritas — mas descreve um modelo que não
    // existe, e num incidente isso custa tempo de leitura de quem procura onde
    // a rota é decidida. Os documentos antigos, se sobraram, ficam inertes: o
    // fallback do `match /{document=**}` nega tudo.
    // -----------------------------------------------------------------

    // -----------------------------------------------------------------
    // absenceDeclarations/{date_childId}
    //   - Ausências declaradas pelo pai (próprio filho) ou pelo admin.
    //   - Id estável `${dateKey}_${childId}` evita duplicação.
    //   - Admin: leitura/escrita total.
    //   - Pai: leitura/escrita SOMENTE de declarações do próprio filho
    //     (validado via children/{childId}.parentUid == auth.uid).
    // -----------------------------------------------------------------
    // -----------------------------------------------------------------
    // schools/{schoolId} — as escolas que CADA motorista atende
    //
    // POR QUE A COLEÇÃO NASCE JÁ ESCOPADA
    // A escola era três campos soltos dentro da criança. Virou entidade porque
    // o aviso em massa agrupa por escola, e agrupar por string digitada à mão
    // ("E.M." numa criança, "EM" na outra) alcançava metade da turma.
    //
    // Nascendo agora, ela nasce com dono: `adminUid` carimbado na criação e
    // imutável no update. O erro que isto evita é o mesmo que `children`,
    // `routePlans` e `liveLocation` tiveram que corrigir depois — com o banco
    // já cheio, uma vez cada. Aqui custa três linhas.
    //
    // O pai NÃO lê esta coleção: o que ele precisa saber sobre a escola do
    // filho já está copiado no doc da criança.
    // -----------------------------------------------------------------
    match /schools/{schoolId} {
      allow read: if isSignedIn() && (ehDoMotorista() || isOwner());

      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid;

      // `adminUid` imutável: transferir a escola pra outro motorista levaria
      // junto o alcance dos avisos das famílias dela.
      allow update: if ehDoMotorista()
        && request.resource.data.adminUid == resource.data.adminUid;

      allow delete: if ehDoMotorista();
    }

    match /absenceDeclarations/{absId} {
      function ownsChild(childId) {
        return isSignedIn()
          && exists(/databases/$(database)/documents/children/$(childId))
          && get(/databases/$(database)/documents/children/$(childId)).data.parentUid == request.auth.uid;
      }

      // Era `isAdmin()` puro: um motorista lia as declarações de ausência das
      // famílias de todos os outros — nome da criança, dia e motivo.
      //
      // `ehDoMotorista()` compara o `adminUid` gravado na declaração, que vem
      // da CRIANÇA e não de quem declarou (o responsável declara a maior parte
      // delas). Declaração antiga, sem `adminUid`, deixa de ser lida pelo
      // motorista — e aqui isso é aceitável porque declaração é do dia: a de
      // hoje é recriada conforme o dia anda, diferente do backfill que
      // `children` exigiu.
      allow read: if isSignedIn() && (
        ehDoMotorista()
        || ownsChild(resource.data.childId)
      );

      allow create: if isAdmin() || (
        isSignedIn()
        && ownsChild(request.resource.data.childId)
        && request.resource.data.declaredBy == 'parent'
      );

      allow update: if isAdmin() || (
        isSignedIn()
        && ownsChild(resource.data.childId)
        && request.resource.data.childId == resource.data.childId
        && request.resource.data.declaredBy == 'parent'
      );

      allow delete: if isAdmin() || (
        isSignedIn() && ownsChild(resource.data.childId)
      );
    }

    // -----------------------------------------------------------------
    // waitlistDrivers/{id} e waitlistParents/{id}
    //   Leads da landing (/conheca). Coleções públicas só pra create
    //   (com auth anônimo). Leitura/edição/delete apenas admin — assim o
    //   admin atual vê quem quer entrar sem expor leads pra outros usuários.
    // -----------------------------------------------------------------
    match /waitlistDrivers/{id} {
      // Criação NEGADA pro cliente: quem grava é a Cloud Function
      // joinDriverWaitlist (Admin SDK), que valida campos, deduplica por
      // email e devolve a posição na fila. Com o create aberto, qualquer
      // visitante anônimo podia inflar a lista do tio com lixo.
      // Continua FECHADO pro público: era por aqui que um visitante anônimo
      // inflava a lista com lixo, e a entrada pública é a callable
      // `joinDriverWaitlist` (que deduplica por e-mail e devolve a posição).
      //
      // O dono cria porque hoje ele é o único canal que funciona: sem Cloud
      // Functions no ar, o formulário da home não grava nada, e o interessado
      // que chega por WhatsApp precisa entrar na fila de algum jeito. Sem
      // isto, a fila fica vazia e o funil não tem o que gerenciar.
      allow create: if isOwner();
      // A fila de parceiros é GESTÃO DA PLATAFORMA, não operação de perua:
      // quem aprova ou recusa um motorista é o dono. O parceiro não tem o
      // que fazer aqui — e ver a fila é ver os concorrentes dele.
      allow read, update, delete: if isOwner();
    }
    match /waitlistParents/{id} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['name', 'email', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // pendingCalls/{id} — "ligação" Tio → Pai pra avisar urgência.
    //   - Admin cria pra qualquer pai (deve setar adminUid = auth.uid).
    //   - Pai (alvo) e Admin (autor) leem.
    //   - Update: dono pode mudar status pra acknowledged (pai) ou
    //     resolved (qualquer um). Admin também pode reescrever campos.
    //   - Delete: só admin.
    // -----------------------------------------------------------------
    match /pendingCalls/{id} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.parentUid == request.auth.uid
        || resource.data.adminUid == request.auth.uid
      );
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.adminUid == resource.data.adminUid
        && request.resource.data.parentUid == resource.data.parentUid
      );
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // schoolBroadcasts/{id} — histórico de avisos "sem aula" disparados
    // pelo admin. Pais não interagem diretamente: o efeito vem via
    // notifications + absenceDeclarations criados no mesmo batch.
    // -----------------------------------------------------------------
    match /schoolBroadcasts/{id} {
      // Era `isAppUser()`, e isso liberava QUALQUER usuário do app a listar o
      // histórico de avisos de TODOS os motoristas — nome de escola, recado e
      // a lista de crianças atingidas. Nenhuma tela lê esta coleção: ela é só
      // histórico de escrita. Leitura passa a ser de quem disparou.
      allow read: if ehDoMotorista() || isOwner();

      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if ehDoMotorista();
    }

    // -----------------------------------------------------------------
    // agendaEntries/{id} — avisos do Tio pro Pai (agenda digital).
    //   - Admin cria e gerencia (deletar/editar próprios).
    //   - Leitura pro Pai: entradas onde parentUid == auth.uid (scope=child)
    //     OU scope=school (filtragem por schoolName fica client-side).
    //   - Pai não escreve nada aqui.
    // -----------------------------------------------------------------
    match /agendaEntries/{id} {
      // O ramo `scope == 'school'` não tinha condição nenhuma além do scope:
      // o responsável de um motorista lia os recados de escola de TODOS os
      // outros. A filtragem por escola era client-side, e filtro de tela não
      // é permissão. Agora o recado carrega `parentUids` — quem estava na
      // escola no momento do envio — e a regra fica exata sem `get()`.
      allow read: if isAppUser() && (
        ehDoMotorista()
        || isOwner()
        || (resource.data.scope == 'child'
            && resource.data.parentUid == request.auth.uid)
        || (resource.data.scope == 'school'
            && request.auth.uid in resource.data.get('parentUids', []))
      );

      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid;

      // Era `isAdmin()`: qualquer motorista editava e APAGAVA o recado de
      // qualquer outro. Escrever na agenda de família alheia é pior que ler.
      allow update, delete: if ehDoMotorista();
    }

    // -----------------------------------------------------------------
    // feedbacks/{id} — avaliações enviadas pelos usuários.
    //   - Qualquer signed-in cria (pra ele mesmo: uid == auth.uid).
    //   - O dono pode ler/listar os próprios feedbacks (pra mostrar "já
    //     enviou antes" no Profile).
    //   - Admin lê tudo (pra analisar respostas e pensar features).
    //   - Não permite update/delete — feedback é imutável.
    // -----------------------------------------------------------------
    match /feedbacks/{id} {
      // Get: dono lê o próprio, admin lê todos, qualquer um lê depoimentos
      //   com allowTestimonial == true (pra exibir na landing pública).
      // List: SOMENTE quando há filtro allowTestimonial == true (pra
      //   alimentar a landing) ou pra admin. O dono não lista — usa get.
      // ATENÇÃO: um depoimento com allowTestimonial=true é legível por
      // QUALQUER UM, sem login. Portanto todo campo deste documento é
      // público na prática — rules não filtram campo na leitura.
      //
      // O que pode morar aqui: uid (não identifica fora do Firebase),
      // PRIMEIRO nome, nota, comentário, e a foto SÓ com allowPhoto.
      // Nunca nome completo, email, telefone ou endereço.
      //
      // Este invariante já foi violado uma vez: o serviço gravava
      // `authorName` completo enquanto este comentário dizia pra não
      // gravar. Comentário em rule não impede código de escrever — se
      // um campo novo aparecer aqui, confira o que o serviço manda.
      // Público só vê depoimento autorizado E não escondido pelo dono.
      allow get: if (
        resource.data.allowTestimonial == true
        && resource.data.get("hiddenByOwner", false) == false
      ) || (
        isSignedIn() && (
          isAdmin() || isOwner() || resource.data.uid == request.auth.uid
        )
      );
      allow list: if isAdmin() || isOwner() || (
        request.query.limit <= 100
        && resource.data.allowTestimonial == true
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'role', 'answers', 'createdAt']);

      // ABRIR E FECHAR DEPOIMENTO É PODER DO DONO, e só isso.
      //
      // O conteúdo continua IMUTÁVEL pra todo mundo, inclusive pra ele: a
      // única chave que se pode tocar é `hiddenByOwner`. Depoimento que o dono
      // pudesse reescrever não seria depoimento — seria texto da plataforma
      // assinado por outra pessoa.
      //
      // Esconder não apaga: o autor continua vendo o que escreveu, e o
      // registro do que foi dito permanece. O que muda é só a vitrine — o
      // `allow get` acima já filtra por esta chave.
      //
      // Isto fecha uma promessa que o app já fazia e não podia cumprir: o
      // ReviewSheet diz "se mudar de ideia, fale com a gente e a gente tira do
      // ar", e até agora não existia caminho de escrita pra isso.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['hiddenByOwner']);
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // supportTickets/{id} — chamados de suporte abertos pelo usuário.
    //   - Dono lê os próprios; admin lê todos.
    //   - Criação: signed-in cria o seu (uid == auth.uid).
    //   - Update: só admin (pra marcar status: open → in_progress → closed).
    //   - Delete: não permitido (histórico imutável).
    // -----------------------------------------------------------------
    match /supportTickets/{id} {
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'role', 'category', 'description', 'status', 'createdAt']);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // expenses/{id} — despesas do motorista (combustível, manutenção...)
    //
    // SOMENTE admin, leitura e escrita. Isto é dado de negócio do tio:
    // quanto ele gasta de combustível ou paga de parcela não é da conta
    // de quem paga a mensalidade. Nenhum responsável enxerga.
    // -----------------------------------------------------------------
    // DESPESA TEM DONO. Era `isAdmin()` puro, com a consulta filtrando só por
    // mês — então cada motorista via, editava e apagava o combustível, a
    // parcela do veículo e o salário do monitor de todos os outros. Sondado
    // com duas contas reais: leitura e alteração cruzadas, HTTP 200 nas duas.
    match /expenses/{id} {
      allow read, delete: if doDono();
      allow create: if nasceDoDono();
      allow update: if doDono() && nasceDoDono();
    }

    // -----------------------------------------------------------------
    // entryBonuses/{uid} — o que a roleta sorteou pra esta conta.
    //
    // NINGUÉM ESCREVE DAQUI. Nem o dono, nem o admin: create, update e
    // delete são `false` pra todos, e quem grava é a callable
    // spinEntryBonus com Admin SDK, que não passa por rules.
    //
    // O motivo é o que o documento é: um benefício em dinheiro. Se o
    // beneficiário pudesse escrever, ele escolheria o prêmio — e a
    // roleta seria enfeite em cima de um campo editável. Se a plataforma
    // pudesse reescrever depois, o registro não sustentaria nenhuma
    // conversa sobre o que foi combinado. Definitivo dos dois lados.
    //
    // O id do documento é o uid de propósito: é o que garante "uma vez
    // por conta" sem depender de contagem nem de campo de controle.
    match /entryBonuses/{uid} {
      allow get: if isSignedIn()
        && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // =================================================================
    // A PLATAFORMA COBRANDO O MOTORISTA
    //
    // Dinheiro em sentido OPOSTO ao de `payments`. Lá é o pai pagando o
    // motorista, e a plataforma não está no caminho. Aqui é o motorista
    // pagando a plataforma, pelo uso do sistema.
    //
    // Manter os dois separados sustenta o item 7 dos Termos ("não processa
    // nem intermedeia transações financeiras"). No dia em que a taxa sair de
    // dentro da mensalidade, essa frase fica falsa.
    // =================================================================

    // taxaConfig/app — percentual padrão, piso e o PIX da PLATAFORMA.
    //
    // Leitura pro motorista também: é onde está a chave PIX pra ele pagar.
    // Esconder isso dele seria cobrar sem dizer pra onde mandar.
    match /taxaConfig/{docId} {
      allow read: if isAppUser();
      allow write: if isOwner();
    }

    // taxaParceiros/{uid} — a NEGOCIAÇÃO. Só o dono, nem o próprio.
    //
    // O motorista NÃO lê o próprio documento, e é deliberado: aqui moram a
    // nota interna do dono e a estrutura de preço. O que ele precisa saber —
    // valor, periodicidade, carência — está no CONTRATO, que é o documento
    // feito pra ele ver.
    //
    // Rules não filtram campo na leitura: liberar o doc pro dono dele seria
    // liberar a nota junto.
    match /taxaParceiros/{uid} {
      allow read, write: if isOwner();
    }

    // faturasParceiro/{id} — o que ele deve, e ele PRECISA ver.
    //
    // Cobrança que o cobrado não consegue conferir é cobrança que ele não tem
    // como contestar. Leitura pro dono da fatura; escrita só do dono da
    // plataforma — quem calcula é quem cobra, e o cobrado não tem caneta.
    match /faturasParceiro/{id} {
      allow read: if isOwner()
        || (isSignedIn() && resource.data.tioUid == request.auth.uid);
      allow write: if isOwner();
    }

    // leadsFunil/{id} — a prospecção comercial.
    //
    // Fechada pro dono e só. A fila de quem está negociando é a lista de
    // concorrentes de quem já é parceiro, e o valor proposto a cada um é
    // informação que muda negociação.
    match /leadsFunil/{id} {
      allow read, write: if isOwner();
    }

    // contratosAssociacao/{id} — o documento entre a plataforma e ele.
    //
    // O DONO ESCREVE, O ASSOCIADO SÓ ACEITA. E aceitar é uma escrita
    // estreitíssima: quatro campos, e só saindo de "sem aceite".
    //
    // Aceite que pode ser reescrito não prova nada — o valor do registro está
    // em ele ser definitivo. Por isso `aceitoEm` só pode ser gravado uma vez,
    // e nem o dono altera cláusula de contrato já aceito: renovar cria
    // documento NOVO, e o anterior fica no histórico.
    match /contratosAssociacao/{id} {
      allow read: if isOwner()
        || (isSignedIn() && resource.data.tioUid == request.auth.uid);
      allow create, delete: if isOwner();

      allow update: if (
        // o associado aceitando o próprio contrato, uma vez só
        isSignedIn()
        && resource.data.tioUid == request.auth.uid
        && resource.data.aceitoEm == null
        && request.resource.data.aceitoEm != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['aceitoEm', 'aceitoPorNome', 'aceiteHash', 'aceiteUserAgent'])
      ) || (
        // o dono só mexe em contrato AINDA NÃO aceito
        isOwner() && resource.data.aceitoEm == null
      );
    }

    // -----------------------------------------------------------------
    // Default deny — qualquer outra coleção é proibida.
    // -----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
