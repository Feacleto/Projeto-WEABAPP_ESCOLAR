rules_version = '2';

// =============================================================================
// Tio Nino Digital — Firestore Security Rules
// =============================================================================
//
// Coleções:
//   users/{uid}        — perfil estendido (role: "admin" | "parent")
//   children/{id}      — crianças cadastradas pelo admin
//   liveLocation/      — doc 'current' com a posição da perua
//   payments/{id}      — mensalidades
//   appState/init      — flag pública "primeiro admin já existe"
//
// Princípios:
//   - Admin tem acesso amplo; pai tem acesso ao próprio filho e seus pagamentos.
//   - Bootstrap do primeiro admin é gated por appState/init (uma vez só).
//   - Signup do pai (signupWithInvite) precisa ler children pra resgatar o
//     invite code; permitido enquanto inviteStatus == 'pending'.
//
// Para deploy: firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }

    // Tem conta de VERDADE no app (doc em users/). A landing chama
    // signInAnonymously pra gravar leads, então `isSignedIn()` sozinho
    // inclui qualquer visitante do site — e não deveria dar acesso a
    // nada que fale de crianças, escolas ou avisos.
    function isAppUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // -----------------------------------------------------------------
    // appState/init — flag de bootstrap.
    //   - Leitura pública (Login precisa checar antes do auth)
    //   - Criação livre apenas se o doc ainda não existir; depois só admin atualiza
    // -----------------------------------------------------------------
    match /appState/{docId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/appState/init);
      allow update: if isAdmin();
      // Admin pode deletar quando "encerrar operação" (deleteAdminAccount).
      // Apagar appState/init restaura o link "Configurar primeiro admin".
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // users/{uid}
    //   - O dono lê e atualiza seu doc
    //   - Admin lê todos
    //   - Criação só pelo dono, e role só pode ser:
    //       * "parent" (signupWithInvite)
    //       * "admin" durante o bootstrap (appState/init ainda não existe)
    //   - Update não pode mudar a role (evita auto-promoção a admin)
    // -----------------------------------------------------------------
    match /users/{uid} {
      // Próprio dono lê o seu doc; admin lê todos.
      //
      // O doc DO admin é legível pelos usuários do app porque o pai
      // precisa ver a chave PIX e o telefone do motorista. Mas isso exige
      // isAppUser(), não isSignedIn(): a landing chama signInAnonymously
      // pra gravar leads, e com isSignedIn() qualquer visitante do site
      // lia nome, email, telefone e CHAVE PIX do motorista.
      allow get: if isSignedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (isAppUser() && resource.data.role == 'admin')
      );
      allow list: if isAdmin();

      // CREATE só existe pro bootstrap do primeiro motorista.
      //
      // A cláusula que aceitava role == 'parent' de qualquer signed-in foi
      // REMOVIDA, e ela era uma escalada de privilégio de verdade:
      //
      //   1. A landing chama signInAnonymously pra gravar leads, então
      //      qualquer visitante do site tem um uid.
      //   2. O create não restringia CAMPOS. Dava pra criar o próprio doc
      //      com role 'parent' E childIds: ['qualquer-id'].
      //   3. Com isso o visitante virava isAppUser() e passava as regras de
      //      liveLocation — ou seja, lia a POSIÇÃO AO VIVO da perua — além do
      //      doc do motorista, com telefone e chave PIX.
      //
      // Nada do cliente precisa disso: desde que o resgate de convite virou
      // Cloud Function, quem cria users/{uid} de responsável é o redeemInvite
      // com Admin SDK, que não passa por rules. Só o bootstrap do admin
      // (createFirstAdmin) ainda escreve daqui.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/appState/init);

      // O dono atualiza o próprio doc, mas NÃO pode mexer em role nem no
      // vínculo de crianças. Quem escreve childIds/childId é a Cloud
      // Function redeemInvite (Admin SDK) — deixar o cliente escrever
      // esses campos permitiria auto-atribuição de filhos.
      allow update: if isSignedIn() && (
        isAdmin()
        || (
          request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['role', 'childId', 'childIds', 'superAdmin'])
        // superAdmin é o gate do painel /admin (App.jsx). Sem ele nesta
        // lista, um responsável legítimo se auto-atribuía e abria a tela.
        // O dano era contido — as leituras de lá exigem isAdmin(), que
        // role=="parent" não satisfaz — mas expor a casca de uma tela
        // administrativa já é informação que ele não deveria ter.
        //
        // NOTA: isto é defesa em profundidade, não a defesa principal. O
        // gate real precisa virar custom claim; enquanto for campo em doc,
        // ele depende de nenhuma regra futura reabrir a escrita.
        )
      );

      // O próprio dono pode apagar (excluir minha conta) ou admin pode
      // apagar qualquer um (remover pai vinculado / encerrar operação).
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // -----------------------------------------------------------------
    // children/{childId}
    //   - Admin: leitura/escrita total
    //   - Pai do filho: leitura
    //   - Resgate de convite NÃO passa mais por aqui: quem resolve o código
    //     é a Cloud Function redeemInvite (Admin SDK, em transação)
    // -----------------------------------------------------------------
    match /children/{childId} {
      // A cláusula `inviteStatus == 'pending'` foi REMOVIDA daqui.
      // Ela existia pra o cliente achar a criança pelo invite code, mas
      // como a landing faz signInAnonymously, qualquer visitante do site
      // conseguia listar todas as crianças pendentes com nome, endereço,
      // coordenada, escola e telefone do responsável.
      // Agora quem resolve convite é a Cloud Function `lookupInvite` /
      // `redeemInvite`, que roda com Admin SDK e devolve o mínimo.
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.parentUid == request.auth.uid
      );

      allow create, delete: if isAdmin();

      // Updates permitidos (não-admin):
      //   a) Aceitar invite: pending → used, parentUid = auth.uid
      //   b) Desvincular (pai apagando própria conta): used → pending,
      //      parentUid = null. Só se parentUid atual é do próprio auth.uid.
      //   c) Aceitar contrato (pai vinculado): grava campos de aceite.
      //      Só permitido se ainda não foi aceito (contractAcceptedAt null).
      // O vínculo pending → used NÃO é mais feito pelo cliente: quem faz é
      // a Cloud Function redeemInvite, em transação (evita dois pais
      // resgatarem o mesmo código). O caminho inverso (desvincular ao
      // apagar a conta) continua aqui — é o próprio dono agindo.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.parentUid == null
        && request.resource.data.inviteStatus == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['parentUid', 'inviteStatus'])
      ) || (
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.contractAcceptedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'contractVersion',
              'contractAcceptedAt',
              'contractAcceptedByUid',
              'contractAcceptedName',
              'contractHash',
              'contractUserAgent',
            ])
      ) || (
        // Pai gerencia lista de responsáveis alternativos do próprio filho
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['altResponsibles'])
      ) || (
        // Pai atualiza foto da própria criança (reflete pro Tio).
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['photoURL'])
      );
    }

    // -----------------------------------------------------------------
    // liveLocation/{docId}
    //   - Todo signed-in lê (admin acompanha telemetria, pai vê perua)
    //   - Só admin escreve (locationService.startTracking/stopTracking)
    // -----------------------------------------------------------------
    match /liveLocation/{docId} {
      // Leitura: admin, ou pai VINCULADO (users/{uid}.childId preenchido).
      // Exigir o doc users/ exclui sessões anônimas — a landing chama
      // signInAnonymously pra gravar leads de waitlist, e sem essa checagem
      // qualquer visitante do site rastreava a perua em tempo real.
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          isAdmin()
          || userDoc().childId != null
          // childIds é o modelo novo (um responsável, vários filhos).
          // Sem esta linha, um pai migrado pro array perderia o mapa.
          || (userDoc().childIds is list && userDoc().childIds.size() > 0)
        );
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------
    // payments/{paymentId}
    //   - Admin: leitura/escrita total
    //   - Pai: leitura SOMENTE dos seus (parentUid == uid)
    //   - Pai: pode atualizar APENAS pra alternar entre 'pending' <-> 'claimed'
    //     (marcar/desmarcar "paguei"). Nunca pode escrever 'paid' direto.
    // -----------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.parentUid == request.auth.uid
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && (
          (resource.data.status == 'pending' && request.resource.data.status == 'claimed')
          || (resource.data.status == 'claimed' && request.resource.data.status == 'pending')
        )
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status',
              'claimedAt',
              'paymentMethod',
              'receiptURL',
              // Hash do arquivo, pro servidor detectar comprovante reusado.
              'receiptHash',
            ])
        // O comprovante tem que ser arquivo do NOSSO Storage. Sem esta
        // checagem o pai gravava qualquer URL no campo, e o tio clicaria
        // nela achando que era o comprovante.
        && (
          !("receiptURL" in request.resource.data)
          || request.resource.data.receiptURL == null
          || request.resource.data.receiptURL.matches(
               'https://firebasestorage[.]googleapis[.]com/.*'
             )
        )
      );
    }

    // -----------------------------------------------------------------
    // payments/{id}/events/{eventId} — trilha APPEND-ONLY do pagamento
    //
    // Só CREATE. Nem update nem delete, pra ninguém — nem pro admin.
    // Essa é justamente a propriedade que faz a trilha valer como prova:
    // antes, `undoReceipt` zerava o claimedAt e o registro de que o pai
    // declarou o pagamento desaparecia. Sem histórico, discordância
    // honesta não tem como ser resolvida, e quem cede é quem tem menos
    // poder na relação.
    //
    // Leitura: admin e o próprio responsável daquele pagamento — os dois
    // lados precisam poder consultar a mesma trilha.
    // -----------------------------------------------------------------
    match /payments/{paymentId}/events/{eventId} {
      function paymentDoc() {
        return get(/databases/$(database)/documents/payments/$(paymentId)).data;
      }

      allow read: if isSignedIn() && (
        isAdmin() || paymentDoc().parentUid == request.auth.uid
      );

      allow create: if isSignedIn()
        && (isAdmin() || paymentDoc().parentUid == request.auth.uid)
        && request.resource.data.keys().hasAll(['type', 'at'])
        && request.resource.data.actorUid == request.auth.uid;

      // Definitivo por design.
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // notifications/{id}
    //   - Cada doc pertence a um único userId (dono).
    //   - Dono lê/atualiza (marcar como lida) seus próprios docs.
    //   - Admin lê tudo (útil pra suporte).
    //   - Criação: signed-in pode criar pra qualquer userId — controle de
    //     conteúdo é validado pelos campos obrigatórios. Cenários válidos:
    //       * Pai cria notif pro tio quando marca pagamento como pago
    //       * Tio cria notif pro pai quando confirma recebimento
    //   - Delete: dono apaga as suas, admin apaga qualquer uma.
    // -----------------------------------------------------------------
    match /notifications/{notifId} {
      // Read combinado (get + list): força a query a ter where userId == auth.uid
      // — sem isso, list seria permissivo demais e usuário poderia consultar
      // notificações alheias.
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );

      // Create: além dos campos obrigatórios, restringe QUEM pode ser alvo.
      //   - Admin (Tio) cria pra qualquer userId.
      //   - Não-admin só cria pra o admin (ex: pai marca "paguei" e avisa o Tio).
      // Sem a segunda cláusula, qualquer signed-in — inclusive sessão anônima
      // da landing — injetava notificação com título/corpo arbitrário na conta
      // de qualquer usuário (phishing in-app).
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasAll(['userId', 'type', 'title', 'createdAt'])
        && request.resource.data.userId is string
        && request.resource.data.type is string
        && (
          isAdmin()
          || request.resource.data.userId ==
              get(/databases/$(database)/documents/appState/init).data.adminUid
        );

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readAt']);

      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
    }

    // -----------------------------------------------------------------
    // altPickups/{dateKey_childId} — indicação diária de quem vai buscar
    //   - Pai pode CRUD do próprio filho.
    //   - Admin lê tudo + também pode escrever (caso queira corrigir).
    // -----------------------------------------------------------------
    match /altPickups/{id} {
      function ownsChild(childId) {
        return isSignedIn()
          && exists(/databases/$(database)/documents/children/$(childId))
          && get(/databases/$(database)/documents/children/$(childId)).data.parentUid == request.auth.uid;
      }
      allow read: if isSignedIn() && (
        isAdmin() || ownsChild(resource.data.childId)
      );
      allow create: if isAdmin() || (
        isSignedIn() && ownsChild(request.resource.data.childId)
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && ownsChild(resource.data.childId)
        && request.resource.data.childId == resource.data.childId
      );
      allow delete: if isAdmin() || (
        isSignedIn() && ownsChild(resource.data.childId)
      );
    }

    // -----------------------------------------------------------------
    // routePlans/{id} — ordem padrão das rotas (ex: routePlans/default).
    //   - Apenas admin lê/escreve. Pais NÃO veem ordem da fila (privacidade).
    // -----------------------------------------------------------------
    match /routePlans/{planId} {
      allow read, write: if isAdmin();
    }

    // -----------------------------------------------------------------
    // dailyRoutes/{YYYY-MM-DD} — overrides do dia (ordem + ausências).
    //   - Apenas admin lê/escreve.
    // -----------------------------------------------------------------
    match /dailyRoutes/{dateKey} {
      allow read, write: if isAdmin();
    }

    // -----------------------------------------------------------------
    // absenceDeclarations/{date_childId}
    //   - Ausências declaradas pelo pai (próprio filho) ou pelo admin.
    //   - Id estável `${dateKey}_${childId}` evita duplicação.
    //   - Admin: leitura/escrita total.
    //   - Pai: leitura/escrita SOMENTE de declarações do próprio filho
    //     (validado via children/{childId}.parentUid == auth.uid).
    // -----------------------------------------------------------------
    match /absenceDeclarations/{absId} {
      function ownsChild(childId) {
        return isSignedIn()
          && exists(/databases/$(database)/documents/children/$(childId))
          && get(/databases/$(database)/documents/children/$(childId)).data.parentUid == request.auth.uid;
      }

      allow read: if isSignedIn() && (
        isAdmin()
        || ownsChild(resource.data.childId)
      );

      allow create: if isAdmin() || (
        isSignedIn()
        && ownsChild(request.resource.data.childId)
        && request.resource.data.declaredBy == 'parent'
      );

      allow update: if isAdmin() || (
        isSignedIn()
        && ownsChild(resource.data.childId)
        && request.resource.data.childId == resource.data.childId
        && request.resource.data.declaredBy == 'parent'
      );

      allow delete: if isAdmin() || (
        isSignedIn() && ownsChild(resource.data.childId)
      );
    }

    // -----------------------------------------------------------------
    // waitlistDrivers/{id} e waitlistParents/{id}
    //   Leads da landing (/conheca). Coleções públicas só pra create
    //   (com auth anônimo). Leitura/edição/delete apenas admin — assim o
    //   admin atual vê quem quer entrar sem expor leads pra outros usuários.
    // -----------------------------------------------------------------
    match /waitlistDrivers/{id} {
      // Criação NEGADA pro cliente: quem grava é a Cloud Function
      // joinDriverWaitlist (Admin SDK), que valida campos, deduplica por
      // email e devolve a posição na fila. Com o create aberto, qualquer
      // visitante anônimo podia inflar a lista do tio com lixo.
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }
    match /waitlistParents/{id} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['name', 'email', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // pendingCalls/{id} — "ligação" Tio → Pai pra avisar urgência.
    //   - Admin cria pra qualquer pai (deve setar adminUid = auth.uid).
    //   - Pai (alvo) e Admin (autor) leem.
    //   - Update: dono pode mudar status pra acknowledged (pai) ou
    //     resolved (qualquer um). Admin também pode reescrever campos.
    //   - Delete: só admin.
    // -----------------------------------------------------------------
    match /pendingCalls/{id} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.parentUid == request.auth.uid
        || resource.data.adminUid == request.auth.uid
      );
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.adminUid == resource.data.adminUid
        && request.resource.data.parentUid == resource.data.parentUid
      );
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // schoolBroadcasts/{id} — histórico de avisos "sem aula" disparados
    // pelo admin. Pais não interagem diretamente: o efeito vem via
    // notifications + absenceDeclarations criados no mesmo batch.
    // -----------------------------------------------------------------
    match /schoolBroadcasts/{id} {
      // isAppUser em vez de isSignedIn: um aviso de "sem aula" carrega o
      // nome da escola e a mensagem do motorista — não é informação pra
      // visitante anônimo da landing.
      allow read: if isAppUser();
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // agendaEntries/{id} — avisos do Tio pro Pai (agenda digital).
    //   - Admin cria e gerencia (deletar/editar próprios).
    //   - Leitura pro Pai: entradas onde parentUid == auth.uid (scope=child)
    //     OU scope=school (filtragem por schoolName fica client-side).
    //   - Pai não escreve nada aqui.
    // -----------------------------------------------------------------
    match /agendaEntries/{id} {
      // A cláusula de scope=school NÃO pode se contentar com
      // isSignedIn(): sessão anônima da landing conseguia ler todos os
      // recados de escola do motorista. Exige conta de verdade.
      allow read: if isAppUser() && (
        isAdmin()
        || (resource.data.scope == 'child'
            && resource.data.parentUid == request.auth.uid)
        || resource.data.scope == 'school'
      );
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // feedbacks/{id} — avaliações enviadas pelos usuários.
    //   - Qualquer signed-in cria (pra ele mesmo: uid == auth.uid).
    //   - O dono pode ler/listar os próprios feedbacks (pra mostrar "já
    //     enviou antes" no Profile).
    //   - Admin lê tudo (pra analisar respostas e pensar features).
    //   - Não permite update/delete — feedback é imutável.
    // -----------------------------------------------------------------
    match /feedbacks/{id} {
      // Get: dono lê o próprio, admin lê todos, qualquer um lê depoimentos
      //   com allowTestimonial == true (pra exibir na landing pública).
      // List: SOMENTE quando há filtro allowTestimonial == true (pra
      //   alimentar a landing) ou pra admin. O dono não lista — usa get.
      // ATENÇÃO: um depoimento com allowTestimonial=true é legível por
      // qualquer um, incluindo o campo `uid` do autor. Isso é aceitável
      // porque o uid não identifica a pessoa fora do Firebase — mas
      // NUNCA adicione nome, email ou telefone a este documento.
      allow get: if (
        resource.data.allowTestimonial == true
      ) || (
        isSignedIn() && (
          isAdmin() || resource.data.uid == request.auth.uid
        )
      );
      allow list: if isAdmin() || (
        request.query.limit <= 100
        && resource.data.allowTestimonial == true
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'role', 'answers', 'createdAt']);
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // supportTickets/{id} — chamados de suporte abertos pelo usuário.
    //   - Dono lê os próprios; admin lê todos.
    //   - Criação: signed-in cria o seu (uid == auth.uid).
    //   - Update: só admin (pra marcar status: open → in_progress → closed).
    //   - Delete: não permitido (histórico imutável).
    // -----------------------------------------------------------------
    match /supportTickets/{id} {
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.uid == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'role', 'category', 'description', 'status', 'createdAt']);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // expenses/{id} — despesas do motorista (combustível, manutenção...)
    //
    // SOMENTE admin, leitura e escrita. Isto é dado de negócio do tio:
    // quanto ele gasta de combustível ou paga de parcela não é da conta
    // de quem paga a mensalidade. Nenhum responsável enxerga.
    // -----------------------------------------------------------------
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    // -----------------------------------------------------------------
    // Default deny — qualquer outra coleção é proibida.
    // -----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
