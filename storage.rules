rules_version = '2';

// =============================================================================
// Alô Buzinou — Storage Security Rules
// =============================================================================
//
// Estrutura:
//   profilePhotos/{uid}     — foto do próprio usuário (tio ou pai)
//   marcaLogos/{uid}        — logo da marca do motorista (o pai dele vê)
//   contratosAnteriores/{childId} — o contrato de papel, antes do app
//   childPhotos/{childId}   — foto de uma criança (só admin escreve)
//   alvaras/{uid}           — o alvará de transporte escolar, para o selo
//
// Princípios:
//   - Read: qualquer signed-in (avatares são "públicos" dentro do app)
//   - Write: dono escreve a própria foto; admin escreve fotos de crianças
//   - Limite de 2 MB por upload (resize client-side já reduz pra ~50 KB)
//   - Validação de content-type pra evitar upload de arquivos não-imagem
//
// Deploy: firebase deploy --only storage
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // A SUSPENSÃO PRECISA VALER AQUI TAMBÉM.
    //
    // `firestore.rules` documenta que negar dentro do `isAdmin()` faz a
    // suspensão valer "pra TODAS as coleções de uma vez". Vale — no Firestore.
    // O Storage tem uma CÓPIA desta função, e a cópia nunca recebeu a trava:
    // motorista suspenso seguia lendo, escrevendo e APAGANDO foto de criança
    // e comprovante bancário.
    //
    // É o custo de ter a mesma decisão escrita em dois arquivos. Quem mexer
    // em `isAdmin()` num deles tem que mexer no outro.
    //
    // ⚠️ AS DUAS CÓPIAS DIVERGEM DE PROPÓSITO NUM PONTO, E ISTO É DECISÃO.
    //
    // Desde 06/09/2026 o `isAdmin()` do FIRESTORE nega também quem está com o
    // teste vencido e sem assinatura (`assinaturaCobreHoje() ||
    // trialCorrendo()`). Esta cópia nega apenas `suspenso`.
    //
    // Não é esquecimento — é a mesma assimetria que `firestore.rules` já
    // assume por escrito: errar permissivo custa uma aba velha escrevendo;
    // errar restritivo tranca um motorista PAGANTE às seis da manhã, sem
    // conserto dentro do produto. E aqui o custo de acertar é maior que lá:
    //
    //   - upload não é cláusula. Quem está bloqueado não consegue escrever
    //     NADA no Firestore, então uma foto ou um comprovante que ele suba
    //     fica inerte — não vira criança, não vira baixa de pagamento.
    //   - a semântica do prazo é sutil: `trialInicio` AUSENTE significa "o
    //     relógio nem começou", e tem que PASSAR. Replicar isso errado aqui
    //     bloquearia a foto da primeira criança do motorista recém-cadastrado
    //     — a primeira coisa que ele faz no app.
    //
    // Então o que a plataforma perde é bytes de quem não paga, e o que ela
    // evita é trancar quem paga. Se essa conta mudar, a trava entra aqui
    // COM caso de teste para `trialInicio` ausente.
    //
    // O que NÃO pode voltar é a assimetria ficar implícita: o CLAUDE.md
    // afirmava "A TRANCA MORA EM `isAdmin()`" sem dizer em qual dos dois
    // arquivos.
    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('suspenso', false) != true;
    }

    // O MOTORISTA DAQUELA CRIANÇA — e não qualquer motorista.
    //
    // `isAdmin()` neste projeto significa TODO parceiro cadastrado. Onde o
    // caminho é determinístico (`childPhotos/{childId}`), usá-lo sozinho
    // libera a plataforma inteira pra quem souber um id. É o mesmo furo que
    // `paymentReceipts` teve e que o comentário lá embaixo conta.
    function isAdminDe(childId) {
      return isAdmin()
        && firestore.exists(/databases/(default)/documents/children/$(childId))
        && firestore.get(/databases/(default)/documents/children/$(childId)).data.get('adminUid', '') == request.auth.uid;
    }

    // Pai/mãe da criança — autorizado a trocar a foto do próprio filho.
    // O backend valida via children/{childId}.parentUid.
    function isParentOf(childId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/children/$(childId))
        && firestore.get(/databases/(default)/documents/children/$(childId)).data.parentUid == request.auth.uid;
    }

    // O DONO DA PLATAFORMA. Cópia da função do Firestore, e a cópia é o
    // problema: quem mexer numa tem que mexer na outra. O comentário do
    // `isAdmin()` acima conta o bug que isso já causou.
    function isOwner() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isWithinSizeLimit() {
      return request.resource.size < 2 * 1024 * 1024; // 2 MB
    }

    // --------------------------------------------------------------------
    // alvaras/{uid} — o alvará de transporte escolar
    // --------------------------------------------------------------------
    //
    // ⚠️ ESTE É O ÚNICO CAMINHO DO STORAGE QUE NÃO É LEGÍVEL POR QUALQUER
    // USUÁRIO LOGADO. Os outros são avatares e comprovantes, "públicos" dentro
    // do app; este é um documento oficial com nome, CPF, placa e endereço.
    //
    // Lê: o dono da plataforma (que confere) e o próprio motorista (que
    // mandou). A família NÃO lê — ela vê o SELO, que é um fato com data, e não
    // o documento. Mostrar o papel a ela seria distribuir dado de terceiro para
    // resolver um problema que uma frase resolve.
    //
    // ALVARÁ, NÃO CNH — e o motivo é técnico: para emitir o alvará a prefeitura
    // já exigiu CNH D, curso, antecedentes e vistoria. Conferir o alvará apoia
    // a plataforma numa conferência que o poder público já fez, sem guardar
    // documento de identidade — que, se vazar, é material de fraude pronto.
    //
    // PDF é aceito além de imagem: prefeitura emite PDF, e obrigar a fotografar
    // a tela faria o documento chegar ilegível.
    match /alvaras/{uid} {
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && isAdmin()
        && isWithinSizeLimit()
        && (isImage() || request.resource.contentType == 'application/pdf');
      // APAGAR É DO DONO. O conferido apagando o documento que sustenta o selo
      // deixaria o selo de pé sem nada por trás.
      allow delete: if isOwner();
    }

    // --------------------------------------------------------------------
    // profilePhotos/{uid} — foto do tio ou pai
    // --------------------------------------------------------------------
    match /profilePhotos/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && isImage()
        && isWithinSizeLimit();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // --------------------------------------------------------------------
    // marcaLogos/{uid} — o logo que o motorista mostra pras famílias dele
    //
    // Separado de `profilePhotos` de propósito: são duas imagens com públicos
    // diferentes. A foto de perfil é o rosto DELE, some num avatar de 32px no
    // canto; o logo é a marca do negócio e aparece no cabeçalho de todo
    // responsável que ele atende. Trocar uma não pode trocar a outra, e o
    // path é o id — sobrescrever é o comportamento certo aqui.
    //
    // `read: isSignedIn()` como as outras: o responsável precisa ver o logo
    // do motorista dele, e o cabeçalho carrega antes de qualquer vínculo ser
    // resolvido. Imagem de marca não é dado sensível — ela existe pra ser
    // mostrada.
    // --------------------------------------------------------------------
    match /marcaLogos/{uid} {
      // ⚠️ A ESCRITA PASSA POR `isAdmin()`, E A LEITURA NÃO — os dois lados
      // têm motivo diferente.
      //
      // LEITURA aberta a qualquer logado porque a família precisa ver: o logo
      // vai no CABEÇALHO do `/pai`, no lugar de "Início" (ver
      // `useMarcaDoTio`). É como o motorista escolhe ser chamado.
      //
      // ESCRITA passou a exigir `isAdmin()` em 09/09/2026, e o que faltava era
      // a SUSPENSÃO: a regra era `isSignedIn() && auth.uid == uid`, então um
      // motorista suspenso pela plataforma continuava trocando a imagem que
      // aparece na tela de todas as famílias dele. Suspensão é decisão de uma
      // pessoa, tomada por causa — e enquanto ela vale, ele não empurra
      // conteúdo para ninguém.
      //
      // Achado por um caso de teste novo, não por leitura: o bloco A CONTA em
      // `scripts/testar-storage.mjs` esperava NEGA e recebeu 200.
      //
      // `auth.uid == uid` continua, e é o que impede um motorista de trocar o
      // logo de OUTRO — `isAdmin()` aqui significa "tem uma conta", nunca
      // escopo.
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.auth.uid == uid
        && isImage()
        && isWithinSizeLimit();
      allow delete: if isAdmin() && request.auth.uid == uid;
    }

    // --------------------------------------------------------------------
    // childPhotos/{childId} — foto da criança (gerenciada pelo Tio)
    // --------------------------------------------------------------------
    // ESCOPADO PELA CRIANÇA, e não por `isAdmin()` puro.
    //
    // Encontrado pelo `scripts/testar-storage.mjs` na primeira vez que estas
    // regras foram testadas: um segundo motorista sobrescrevia e apagava a
    // FOTO DE QUALQUER CRIANÇA da plataforma, e lia a de todas. O caminho é o
    // id da criança, então bastava conhecer um.
    //
    // Passava despercebido pelo mesmo motivo que o furo gêmeo de `children`
    // no Firestore: com um parceiro só, ninguém vê o problema. É a classe de
    // falha que aparece no dia em que o produto dá certo.
    //
    // A LEITURA TAMBÉM FECHOU. Era `isSignedIn()`, com o argumento de que
    // "avatares são públicos dentro do app". Não são: é o rosto de uma
    // criança, e quem precisa vê-lo são o motorista dela e o responsável
    // dela. Mais ninguém — nem o pai da turma do lado.
    match /childPhotos/{childId} {
      allow read: if isAdminDe(childId) || isParentOf(childId);
      allow write: if (isAdminDe(childId) || isParentOf(childId))
        && isImage()
        && isWithinSizeLimit();
      allow delete: if isAdminDe(childId) || isParentOf(childId);
    }

    // --------------------------------------------------------------------
    // paymentReceipts/{paymentId} — comprovante que o pai anexa ao avisar
    // que pagou. Fecha o ciclo pagar → comprovar → confirmar dentro do app,
    // em vez de virar conversa paralela no WhatsApp.
    //
    // Leitura restrita: só o admin e o próprio pai daquele pagamento. Um
    // comprovante bancário tem nome, valor e às vezes agência/conta — não é
    // arquivo "público dentro do app" como os avatares.
    // --------------------------------------------------------------------
    // ------------------------------------------------------------------
    // contratosAnteriores/{childId} — o contrato de papel, antes do app
    //
    // ESCOPADO PELO DONO DA CRIANÇA, e não por `isAdmin()`. O caminho é
    // determinístico, então `isAdmin()` puro deixaria qualquer parceiro da
    // plataforma ler o contrato de qualquer família de qualquer concorrente —
    // com valor combinado, endereço e nome dos responsáveis. É exatamente o
    // furo que `paymentReceipts` teve e que o comentário logo abaixo conta.
    //
    // O RESPONSÁVEL LÊ, e não escreve. É o contrato dele: negar a leitura
    // seria guardar um documento sobre a pessoa e não deixar ela ver. Mas
    // quem sobe é o motorista — documento que define quanto o pai paga não
    // pode entrar pela mão de quem paga.
    // ------------------------------------------------------------------
    match /contratosAnteriores/{childId} {
      function crianca() {
        return firestore.get(/databases/(default)/documents/children/$(childId)).data;
      }
      function existeCrianca() {
        return firestore.exists(/databases/(default)/documents/children/$(childId));
      }
      function ehOMotorista() {
        return isAdmin()
          && existeCrianca()
          && crianca().get('adminUid', '') == request.auth.uid;
      }
      function ehOResponsavel() {
        return isSignedIn()
          && existeCrianca()
          && crianca().get('parentUid', '') == request.auth.uid;
      }
      allow read: if ehOMotorista() || ehOResponsavel();
      allow write: if ehOMotorista()
        && (isImage() || request.resource.contentType == 'application/pdf')
        && isWithinSizeLimit();
      allow delete: if ehOMotorista();
    }

    match /paymentReceipts/{paymentId} {
      function pagamento() {
        return firestore.get(/databases/(default)/documents/payments/$(paymentId)).data;
      }
      function existePagamento() {
        return firestore.exists(/databases/(default)/documents/payments/$(paymentId));
      }
      function isPayer() {
        return isSignedIn()
          && existePagamento()
          && pagamento().parentUid == request.auth.uid;
      }
      // O MOTORISTA DAQUELE PAGAMENTO, não qualquer motorista.
      //
      // O comentário acima já dizia "só o admin e o próprio pai daquele
      // pagamento" — mas `isAdmin()` aqui significa TODO motorista cadastrado,
      // e o caminho é determinístico (`paymentReceipts/{paymentId}`). Qualquer
      // parceiro lia, sobrescrevia e apagava o comprovante bancário de
      // qualquer família da plataforma: nome, valor e às vezes agência e conta.
      function isDono() {
        return isAdmin()
          && existePagamento()
          && pagamento().get('adminUid', '') == request.auth.uid;
      }
      allow read: if isDono() || isPayer();
      // O TIO também anexa. Na prática o pai paga e manda o comprovante
      // pelo WhatsApp sem passar pelo app — sem isto, aquele comprovante
      // não entra no histórico e o registro do mês fica incompleto.
      allow write: if (isDono() || isPayer())
        && (isImage() || request.resource.contentType == 'application/pdf')
        && isWithinSizeLimit();
      // O pai pode trocar o comprovante errado; o motorista daquele pagamento
      // limpa depois de conferir, se quiser.
      allow delete: if isDono() || isPayer();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
