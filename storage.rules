rules_version = '2';

// =============================================================================
// Alô Buzinou — Storage Security Rules
// =============================================================================
//
// Estrutura:
//   profilePhotos/{uid}     — foto do próprio usuário (tio ou pai)
//   childPhotos/{childId}   — foto de uma criança (só admin escreve)
//
// Princípios:
//   - Read: qualquer signed-in (avatares são "públicos" dentro do app)
//   - Write: dono escreve a própria foto; admin escreve fotos de crianças
//   - Limite de 2 MB por upload (resize client-side já reduz pra ~50 KB)
//   - Validação de content-type pra evitar upload de arquivos não-imagem
//
// Deploy: firebase deploy --only storage
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Pai/mãe da criança — autorizado a trocar a foto do próprio filho.
    // O backend valida via children/{childId}.parentUid.
    function isParentOf(childId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/children/$(childId))
        && firestore.get(/databases/(default)/documents/children/$(childId)).data.parentUid == request.auth.uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isWithinSizeLimit() {
      return request.resource.size < 2 * 1024 * 1024; // 2 MB
    }

    // --------------------------------------------------------------------
    // profilePhotos/{uid} — foto do tio ou pai
    // --------------------------------------------------------------------
    match /profilePhotos/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && isImage()
        && isWithinSizeLimit();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // --------------------------------------------------------------------
    // childPhotos/{childId} — foto da criança (gerenciada pelo Tio)
    // --------------------------------------------------------------------
    match /childPhotos/{childId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isParentOf(childId))
        && isImage()
        && isWithinSizeLimit();
      allow delete: if isAdmin() || isParentOf(childId);
    }

    // --------------------------------------------------------------------
    // paymentReceipts/{paymentId} — comprovante que o pai anexa ao avisar
    // que pagou. Fecha o ciclo pagar → comprovar → confirmar dentro do app,
    // em vez de virar conversa paralela no WhatsApp.
    //
    // Leitura restrita: só o admin e o próprio pai daquele pagamento. Um
    // comprovante bancário tem nome, valor e às vezes agência/conta — não é
    // arquivo "público dentro do app" como os avatares.
    // --------------------------------------------------------------------
    match /paymentReceipts/{paymentId} {
      function isPayer() {
        return isSignedIn()
          && firestore.exists(/databases/(default)/documents/payments/$(paymentId))
          && firestore.get(/databases/(default)/documents/payments/$(paymentId)).data.parentUid == request.auth.uid;
      }
      allow read: if isAdmin() || isPayer();
      // O TIO também anexa. Na prática o pai paga e manda o comprovante
      // pelo WhatsApp sem passar pelo app — sem isto, aquele comprovante
      // não entra no histórico e o registro do mês fica incompleto.
      allow write: if (isAdmin() || isPayer())
        && (isImage() || request.resource.contentType == 'application/pdf')
        && isWithinSizeLimit();
      // O pai pode trocar o comprovante errado; o admin limpa depois de
      // conferir, se quiser.
      allow delete: if isAdmin() || isPayer();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
